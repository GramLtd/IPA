# Приложение из https://developers.tiktok.com (продукты Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Должен совпадать с Redirect URI в настройках приложения TikTok (нужен HTTPS-домен)
TIKTOK_REDIRECT_URI=https://your-domain.com/oauth/callback

# Вход в панель (HTTP Basic)
PANEL_USER=admin
PANEL_PASSWORD=

DATA_DIR=data
WORKER_INTERVAL=10
